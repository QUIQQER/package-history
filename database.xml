<?xml version="1.0" encoding="UTF-8"?>
<database>

    <projects>
        <table name="archiv" no-auto-update="1" no-site-reference="1">
            <field type="bigint">id</field>
            <field type="datetime">created</field>
            <field type="text" nullable="true" default="null">data</field>
            <field type="string" length="50">uid</field>

            <primary>id,created</primary>
        </table>

        <table name="history_bricks" no-auto-update="1" no-site-reference="1">
            <field type="integer">id</field>
            <field type="datetime">created</field>
            <field type="text" nullable="true" default="null">data</field>
            <field type="string" length="50">uid</field>

            <primary>id,created</primary>
        </table>
    </projects>

</database>
